# ── Cascade — environment (copy to .env; .env is gitignored) ─────────────────
# Dev defaults are safe for local Docker only. Never reuse these in production.

# ── Postgres (Docker) ────────────────────────────────────────────────────────
POSTGRES_SUPERUSER_PASSWORD=postgres
CASCADE_OWNER_PASSWORD=owner_dev_pw
CASCADE_APP_PASSWORD=app_dev_pw

# App DB connection — the RLS-constrained role used by the API and Celery worker.
DATABASE_URL=postgresql+asyncpg://cascade_app:app_dev_pw@localhost:5432/cascade
# Migration connection — the schema owner, used only by Alembic.
OWNER_DATABASE_URL=postgresql+psycopg://cascade_owner:owner_dev_pw@localhost:5432/cascade

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth / security ──────────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me-to-a-32-byte-random-string
JWT_ACCESS_TTL_SECONDS=900
SESSION_IDLE_TTL_SECONDS=1209600
ARGON2_TIME_COST=3

# ── App ──────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
CSV_ASYNC_THRESHOLD=1000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ── Frontend (apps/web) ──────────────────────────────────────────────────────
# Server-side (BFF proxy) URL to reach FastAPI. Browser never calls FastAPI directly.
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Cascade
