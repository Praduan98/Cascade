# ── Cascade frontend — environment (copy to apps/web/.env.local) ─────────────
# Phase 1 is frontend-only and runs on a mock data layer (in-memory + localStorage),
# so no backend/database configuration is required to run the app.

NEXT_PUBLIC_APP_NAME=Cascade

# When a real backend is later introduced, swap the data layer implementation and set:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
