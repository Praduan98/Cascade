# ── Cascade frontend — environment (copy to apps/web/.env.local) ─────────────
# Phase 1 is frontend-only and runs on a mock data layer (in-memory + localStorage),
# so no backend/database configuration is required to run the app.

NEXT_PUBLIC_APP_NAME=Cascade

# ── Data backend ─────────────────────────────────────────────────────────────
# Selects the CascadeApi implementation behind getApi():
#   mock (default) → in-memory MockApi (no backend required)
#   http           → real HttpApi (requires NEXT_PUBLIC_API_BASE_URL below)
NEXT_PUBLIC_API_BACKEND=mock

# Required when NEXT_PUBLIC_API_BACKEND=http. The client calls `${...}/v1`
# (e.g. this value → requests hit http://localhost:8000/v1/...). See
# packages/data/CONTRACT.md for the endpoint map.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
